#!/usr/bin/env python3
"""Re-apply Antigravity CLI (agy) region patches. Run after `agy update`."""
from __future__ import annotations
import fcntl, hashlib, os, re, shutil, sys
from pathlib import Path

home = Path.home()
_default = home / ".local/bin/agy.real"
if not _default.is_file():
    _default = home / ".local/bin/agy"
SRC = Path(os.environ.get("AGY_BIN", str(_default)))
BAK = SRC.with_name(SRC.name + ".agybak")
TMP = SRC.with_name(SRC.name + ".new")
LOCK_DIR = home / ".cache" / "linux-agy-patcher"
LOCK_PATH = LOCK_DIR / "repatch.lock"
WRAPPER = home / ".local/bin/agy"
REAL = home / ".local/bin/agy.real"
HERE = Path(__file__).resolve().parent


def acquire_lock():
    LOCK_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def apply_regex_fix(data: bytearray, sig: bytes, patched: bytes, fix: bytes, offset: int, label: str, all_hits=True) -> int:
    cre = re.compile(sig, re.S)
    pre = re.compile(patched, re.S)
    already = list(pre.finditer(data))
    hits = list(cre.finditer(data))
    print(f"[{label}] unpatched={len(hits)} already={len(already)}")
    if not hits:
        if already:
            return 0
        print(f"[{label}] signature not found — unsupported agy build")
        return -1
    n = 0
    for m in reversed(hits):
        off = m.start() + offset
        data[off:off + len(fix)] = fix
        print(f"  patched 0x{off:x}")
        n += 1
        if not all_hits:
            break
    return n


def load_wrapper_src() -> str:
    env = os.environ.get("AGY_WRAPPER_SRC")
    candidates = [
        Path(env) if env else None,
        HERE / "agy-wrapper.tmpl",
        HERE / "agy-wrapper",
        home / ".local/bin/agy-wrapper.tmpl",
    ]
    for p in candidates:
        if p is None or not p.is_file():
            continue
        try:
            with p.open("rb") as f:
                if f.read(4) == b"\x7fELF":
                    continue
            text = p.read_text()
        except OSError:
            continue
        if "agy.real" in text and '== "update"' in text:
            print("wrapper template", p)
            return text
    sys.exit("agy-wrapper.tmpl not found (re-run install.sh)")


def ensure_real_binary():
    """If updater overwrote the wrapper with a fresh ELF, move it to agy.real."""
    global SRC
    if WRAPPER.is_file():
        with WRAPPER.open("rb") as f:
            magic = f.read(4)
        if magic == b"\x7fELF":
            print("agy is a fresh ELF (update overwrote wrapper) -> agy.real")
            shutil.copy2(WRAPPER, REAL)
            SRC = REAL
    if not SRC.is_file() and REAL.is_file():
        SRC = REAL


def write_wrapper(src: str):
    if WRAPPER.is_file():
        with WRAPPER.open("rb") as f:
            magic = f.read(4)
        if magic != b"\x7fELF":
            try:
                if WRAPPER.read_text() == src:
                    print("wrapper already in place")
                    return
            except UnicodeDecodeError:
                pass
    WRAPPER.write_text(src)
    os.chmod(WRAPPER, 0o755)
    print("wrapper restored ->", WRAPPER)


_lock_fd = acquire_lock()
ensure_real_binary()
if not SRC.is_file():
    sys.exit(f"agy not found: {SRC}")

wrapper_src = load_wrapper_src()
# Restore wrapper before patching so a signature miss still leaves the proxy path.
write_wrapper(wrapper_src)

print("target", SRC, "size", SRC.stat().st_size)
print("sha256", sha256(SRC))
data = bytearray(SRC.read_bytes())
n = 0
miss = 0
r = apply_regex_fix(
    data,
    rb"\x48\x85\xc0\x0f\x84....\x80\x78\x08\x00\x0f\x85....",
    rb"\x48\x85\xc0\x0f\x84....\x48\x85\xc0\x90\x0f\x85....",
    b"\x48\x85\xc0\x90",
    9, "CLI eligibility", True,
)
if r < 0:
    miss += 1
else:
    n += r
r = apply_regex_fix(
    data,
    rb"\x80\x78\x08\x00\x74.\x48\x8b.\x24.\x48\x89.\x60",
    rb"\xc6\x40\x08\x01\x90\x90\x48\x8b.\x24.\x48\x89.\x60",
    b"\xc6\x40\x08\x01\x90\x90",
    0, "hasValidAuth", False,
)
if r < 0:
    miss += 1
else:
    n += r
for old, new in (
    (b"\n\nineligible\x18\x03", b"\n\ninexigible\x18\x03"),
    (b"name=ineligible,proto3,oneof", b"name=inexigible,proto3,oneof"),
):
    c = bytes(data).count(old)
    print(f"[proto] {old!r} -> {c}")
    if c:
        data = bytearray(bytes(data).replace(old, new))
        n += c

if n:
    if not BAK.exists() or BAK.stat().st_size != SRC.stat().st_size:
        print("backup ->", BAK)
        shutil.copy2(SRC, BAK)
    TMP.write_bytes(data)
    os.chmod(TMP, 0o755)
    try:
        SRC.unlink()
    except OSError as e:
        print("unlink:", e)
    os.replace(TMP, SRC)
    os.chmod(SRC, 0o755)
    print("sha256 after", sha256(SRC))
else:
    print("binary already patched" if not miss else "binary unchanged (signatures missed)")

print("OK, restart agy")
if miss:
    sys.exit(1)
