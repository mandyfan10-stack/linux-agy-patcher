#!/usr/bin/env python3
"""CONNECT proxy for agy CloudCode.

Race unblock DNS (dns-ai DoT / geohide / xbox-dns / comss) against
8.8.8.8/1.1.1.1, keep only substituted answers, probe TLS+SNI, then tunnel.
Everything else is a direct CONNECT. No cert MITM.

Strategy from confeden/Antigravity v2.9.1_29 src/resolvers.rs plus dns-ai.ru DoT.
"""
from __future__ import annotations

import ipaddress
import logging
import os
import select
import socket
import ssl
import struct
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Iterable

LISTEN = ("127.0.0.1", int(os.environ.get("AGY_PROXY_PORT", "18080")))
CONNECT_TIMEOUT = 0.9
DNS_TIMEOUT = 0.7
TLS_BUDGET = 1.5
CACHE_TTL = 180.0
STALE_TTL = 900.0
WARM_EVERY = 45.0
# confeden v2.9.1_30/31/33: idle 90s killed Antigravity's pool; ban a dead edge 5 min
QUARANTINE_SEC = 300.0

CLOUDCODE_HOSTS = {
    "daily-cloudcode-pa.googleapis.com",
    "cloudcode-pa.googleapis.com",
    "generativelanguage.googleapis.com",
}

# confeden src/resolvers.rs PROVIDERS + REFERENCE_V4
PROVIDERS: list[tuple[str, tuple[str, ...]]] = [
    ("geohide.ru", ("45.155.204.190", "37.230.192.51")),
    ("xbox-dns.ru", ("111.88.96.50", "111.88.96.51")),
    ("comss.one", ("83.220.169.155", "212.109.195.93", "195.133.25.16")),
]
# dns-ai.ru (Nova): DoT/DoH only — UDP/53 is closed and intercepted from RU.
# Name: (label, TLS SNI, bootstrap IPs of dns.dns-ai.ru)
DOT_PROVIDERS: list[tuple[str, str, tuple[str, ...]]] = [
    ("dns-ai.ru", "dns.dns-ai.ru", ("186.246.49.127", "217.60.10.20")),
]
DOT_TIMEOUT = 1.5
REFERENCE = ("8.8.8.8", "1.1.1.1")
REFERENCE_STUBS = {ipaddress.IPv4Address("8.6.112.0"), ipaddress.IPv4Address("8.47.69.0")}
# 95.182.120.241 timed out from RU (Aug 2026) — do not dial it
# dns-ai NL edge 186.246.45.126 accepted TCP but timed out TLS (31 Aug 2026);
# keep it off FALLBACK so happy-eyeballs cannot pick a silent IP.
FALLBACK = ("45.155.204.190", "37.230.192.51")
_DOT_CTX = ssl.create_default_context()

log = logging.getLogger("agy-proxy")
_cache_lock = threading.Lock()
# host -> (ips, provider, t_monotonic)
_cache: dict[str, tuple[list[str], str, float]] = {}
_sticky: dict[str, str] = {}
_inflight: dict[str, threading.Event] = {}
_inflight_lock = threading.Lock()
_last_route: tuple | None = None
_quarantine: dict[str, float] = {}
_q_lock = threading.Lock()
_state_path = os.path.expanduser("~/.cache/linux-agy-patcher/state.log")


def _log_line(msg: str) -> None:
    log.info(msg)
    try:
        os.makedirs(os.path.dirname(_state_path), exist_ok=True)
        with open(_state_path, "a", encoding="utf-8") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    except OSError:
        pass


def _log_route(name: str, provider: str, ips: list[str]) -> None:
    global _last_route
    key = (name, provider, tuple(ips))
    if key == _last_route:
        return
    _last_route = key
    _log_line(f"{name} via {provider} -> {','.join(ips)}")


def _block16(ip: str) -> tuple[int, int]:
    a = ipaddress.ip_address(ip)
    if isinstance(a, ipaddress.IPv4Address):
        n = int(a)
        return (4, n & 0xFFFF0000)
    o = a.packed
    return (6, (o[0] << 24) | (o[1] << 16) | (o[2] << 8) | o[3])


def _build_query(name: str, qid: int = 0x5A5A) -> bytes:
    q = struct.pack(">H", qid) + b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00"
    for label in name.split("."):
        raw = label.encode("ascii")
        q += bytes([len(raw)]) + raw
    q += b"\x00" + struct.pack(">HH", 1, 1)
    return q


def _parse_a(resp: bytes) -> list[str]:
    if len(resp) < 12:
        return []
    ancount = struct.unpack(">H", resp[4:6])[0]
    i = 12
    while i < len(resp) and resp[i] != 0:
        i += 1 + resp[i]
    i += 5
    out: list[str] = []
    for _ in range(ancount):
        if i >= len(resp):
            break
        if resp[i] & 0xC0 == 0xC0:
            i += 2
        else:
            while i < len(resp) and resp[i] != 0:
                i += 1 + resp[i]
            i += 1
        if i + 10 > len(resp):
            break
        typ, _cls, _ttl, rdlen = struct.unpack(">HHIH", resp[i : i + 10])
        i += 10
        rdata = resp[i : i + rdlen]
        i += rdlen
        if typ == 1 and rdlen == 4:
            out.append(socket.inet_ntoa(rdata))
    return out


def _src_ip() -> str | None:
    """Prefer a non-tunnel IPv4 so unblock DNS still sees a RU client."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("8.8.8.8", 53))
            ip = s.getsockname()[0]
    except OSError:
        return None
    skip = ip.startswith("172.19.") or ip.startswith("10.0.") or ip.startswith("198.18.")
    if skip:
        return None
    return ip


def _dns_query(server: str, name: str, src: str | None) -> list[str]:
    q = _build_query(name)
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(DNS_TIMEOUT)
    try:
        if src:
            try:
                sock.bind((src, 0))
            except OSError:
                pass
        sock.sendto(q, (server, 53))
        data, _ = sock.recvfrom(4096)
        return _parse_a(data)
    except OSError:
        return []
    finally:
        sock.close()


def _dot_query(server: str, name: str, sni: str) -> list[str]:
    """RFC 7858 DoT. dns-ai.ru does not serve UDP/53."""
    q = _build_query(name)
    framed = struct.pack(">H", len(q)) + q
    raw = None
    ss = None
    try:
        raw = socket.create_connection((server, 853), timeout=DOT_TIMEOUT)
        raw.settimeout(DOT_TIMEOUT)
        ss = _DOT_CTX.wrap_socket(raw, server_hostname=sni)
        ss.sendall(framed)
        hdr = b""
        while len(hdr) < 2:
            chunk = ss.recv(2 - len(hdr))
            if not chunk:
                return []
            hdr += chunk
        ln = struct.unpack(">H", hdr)[0]
        if ln == 0 or ln > 4096:
            return []
        body = b""
        while len(body) < ln:
            chunk = ss.recv(ln - len(body))
            if not chunk:
                break
            body += chunk
        return _parse_a(body)
    except OSError:
        return []
    finally:
        for s in (ss, raw):
            if s is None:
                continue
            try:
                s.close()
            except OSError:
                pass


def _uniq(seq: Iterable[str]) -> list[str]:
    out: list[str] = []
    for x in seq:
        if x not in out:
            out.append(x)
    return out


def _with_sticky(name: str, ips: list[str]) -> list[str]:
    stick = _sticky.get(name)
    if stick and _is_banned(stick):
        _sticky.pop(name, None)
        stick = None
    if stick and stick in ips:
        return [stick] + [i for i in ips if i != stick]
    return list(ips)


def _is_banned(ip: str) -> bool:
    with _q_lock:
        until = _quarantine.get(ip)
        if until is None:
            return False
        if time.monotonic() >= until:
            _quarantine.pop(ip, None)
            return False
        return True


def _usable(ips: list[str]) -> list[str]:
    ok = [i for i in ips if not _is_banned(i)]
    return ok or list(ips)


def _ban(ip: str, why: str) -> None:
    with _q_lock:
        _quarantine[ip] = time.monotonic() + QUARANTINE_SEC
    for host, stick in list(_sticky.items()):
        if stick == ip:
            _sticky.pop(host, None)
    _log_line(f"quarantine {ip} {int(QUARANTINE_SEC)}s ({why})")


def _reference(name: str, src: str | None) -> list[str]:
    addrs: list[str] = []
    with ThreadPoolExecutor(max_workers=len(REFERENCE)) as pool:
        futs = [pool.submit(_dns_query, server, name, src) for server in REFERENCE]
        for fut in as_completed(futs):
            try:
                addrs.extend(fut.result())
            except Exception:
                pass
    clean = []
    for a in addrs:
        try:
            ip = ipaddress.ip_address(a)
        except ValueError:
            continue
        if ip in REFERENCE_STUBS:
            continue
        clean.append(a)
    return clean


def _is_substituted(candidate: Iterable[str], reference: list[str]) -> bool:
    cands = list(candidate)
    if not cands or not reference:
        return False
    ref_blocks = {_block16(a) for a in reference}
    if any(_block16(a) in ref_blocks for a in cands):
        return False
    return True


def _http_ok(ip: str, sni: str, budget: float = TLS_BUDGET) -> bool:
    """True if CloudCode answers HTTP (401/200), not RST/EOF/location 400."""
    try:
        raw = socket.create_connection((ip, 443), timeout=min(0.9, budget))
        _tune(raw)
        raw.settimeout(budget)
        ctx = ssl.create_default_context()
        ss = ctx.wrap_socket(raw, server_hostname=sni)
        req = (
            b"POST /v1internal:loadCodeAssist HTTP/1.1\r\n"
            b"Host: " + sni.encode("ascii") + b"\r\n"
            b"Content-Type: application/json\r\n"
            b"Content-Length: 2\r\n"
            b"Connection: close\r\n\r\n{}"
        )
        ss.sendall(req)
        data = b""
        while len(data) < 256:
            chunk = ss.recv(256)
            if not chunk:
                break
            data += chunk
        ss.close()
    except OSError:
        return False
    if not data:
        return False
    if b"User location is not supported" in data:
        return False
    head = data.split(b"\r\n", 1)[0]
    return b"401" in head or b"200" in head or b"403" in head


def _first_tcp_ok(ips: list[str], timeout: float = 0.9) -> list[str]:
    if not ips:
        return []
    live: list[str] = []
    lock = threading.Lock()
    with ThreadPoolExecutor(max_workers=min(4, len(ips))) as pool:
        futs = {pool.submit(_tcp_alive, ip, 443, timeout): ip for ip in ips}
        try:
            for fut in as_completed(futs, timeout=timeout + 0.2):
                ip = futs[fut]
                try:
                    ok = fut.result()
                except Exception:
                    ok = False
                if ok:
                    with lock:
                        live.append(ip)
        except TimeoutError:
            pass
    return live


def _first_http_ok(ips: list[str], sni: str) -> list[str]:
    if not ips:
        return []
    live: list[str] = []
    lock = threading.Lock()
    with ThreadPoolExecutor(max_workers=min(4, len(ips))) as pool:
        futs = {pool.submit(_http_ok, ip, sni): ip for ip in ips}
        try:
            for fut in as_completed(futs, timeout=TLS_BUDGET + 0.4):
                ip = futs[fut]
                try:
                    ok = fut.result()
                except Exception:
                    ok = False
                if ok:
                    with lock:
                        live.append(ip)
        except TimeoutError:
            pass
    return live


def _race(name: str) -> tuple[list[str], str]:
    src = _src_ip()
    ref = _reference(name, src)
    best: list[str] = []
    best_name = ""
    grouped: dict[str, list[str]] = {p: [] for p, _ in PROVIDERS}
    for pname, _sni, _servers in DOT_PROVIDERS:
        grouped.setdefault(pname, [])
    n_jobs = sum(len(s) for _, s in PROVIDERS) + sum(len(s) for _, _, s in DOT_PROVIDERS)
    with ThreadPoolExecutor(max_workers=max(8, n_jobs)) as pool:
        futs = {}
        for pname, sni, servers in DOT_PROVIDERS:
            for server in servers:
                futs[pool.submit(_dot_query, server, name, sni)] = pname
        for pname, servers in PROVIDERS:
            for server in servers:
                futs[pool.submit(_dns_query, server, name, src)] = pname
        for fut in as_completed(futs):
            pname = futs[fut]
            try:
                grouped[pname].extend(fut.result())
            except Exception:
                pass
    # dns-ai first: CloudCode-specific NL edge, once TLS there is open
    order = [p for p, _, _ in DOT_PROVIDERS] + [p for p, _ in PROVIDERS]
    for pname in order:
        seen = _uniq(grouped.get(pname, []))
        if not seen:
            continue
        if _is_substituted(seen, ref):
            candidates = [i for i in seen if not _is_banned(i)]
            if not candidates:
                continue
            live = _first_tcp_ok(candidates)
            if live:
                # v2.10.0_3: an IP can accept TCP and then stay silent
                http = _first_http_ok(live, name)
                if http:
                    return http, pname
                for ip in live:
                    _ban(ip, "tcp-only-silent")
                if not best:
                    best, best_name = live, pname + "(tcp-only)"
                continue
        else:
            log.debug("%s passthrough for %s -> %s", pname, name, seen)
    live = _first_tcp_ok(list(FALLBACK))
    if live:
        http = _first_http_ok(live, name)
        if http:
            return http, "fallback-geohide"
        return live, "fallback-geohide(tcp-only)"
    if best:
        return best, best_name + "(no-live-tls)"
    return list(FALLBACK), "fallback-unproven"


def _rank_http(name: str, ips: list[str]) -> None:
    """Prefer IPs that actually answer CloudCode HTTP; does not block CONNECT."""
    live = _first_http_ok(_uniq(list(ips) + list(FALLBACK)), name)
    if not live:
        return
    cur = _sticky.get(name)
    if cur not in live:
        _sticky[name] = live[0]
    with _cache_lock:
        hit = _cache.get(name)
        if hit:
            ordered = _uniq(live + [i for i in hit[0] if i not in live])
            _cache[name] = (ordered, hit[1], hit[2])


def _refresh(name: str) -> list[str]:
    with _inflight_lock:
        ev = _inflight.get(name)
        mine = ev is None
        if mine:
            ev = threading.Event()
            _inflight[name] = ev
    if not mine:
        ev.wait(8)
        with _cache_lock:
            hit = _cache.get(name)
        return list(hit[0]) if hit else list(FALLBACK)
    try:
        ips, provider = _race(name)
        ips = _uniq(ips)
        with _cache_lock:
            _cache[name] = (ips, provider, time.monotonic())
        _log_route(name, provider, ips)
        threading.Thread(target=_rank_http, args=(name, ips), daemon=True).start()
        return ips
    except Exception as e:
        log.warning("race failed for %s: %s", name, e)
        with _cache_lock:
            hit = _cache.get(name)
        if hit:
            return list(hit[0])
        return list(FALLBACK)
    finally:
        with _inflight_lock:
            _inflight.pop(name, None)
        ev.set()


def resolve_cloudcode(name: str, force: bool = False) -> list[str]:
    now = time.monotonic()
    with _cache_lock:
        hit = _cache.get(name)
        if not force and hit and now - hit[2] < CACHE_TTL:
            return _with_sticky(name, hit[0])
        stale = hit if hit and now - hit[2] < STALE_TTL else None
    if not force and stale:
        threading.Thread(target=_refresh, args=(name,), daemon=True).start()
        return _with_sticky(name, stale[0])
    return _with_sticky(name, _refresh(name))


def _pipe(client: socket.socket, upstream: socket.socket) -> tuple[str, int, int]:
    """Copy until a peer closes. Do not kill idle tunnels (confeden v2.9.1_30)."""
    c2u = 0
    u2c = 0
    reason = "eof"
    try:
        while True:
            r, _, x = select.select([client, upstream], [], [client, upstream], 60)
            if x:
                reason = "error"
                break
            if not r:
                continue
            for src in r:
                dst = upstream if src is client else client
                data = src.recv(65536)
                if not data:
                    reason = "client-eof" if src is client else "upstream-eof"
                    return reason, c2u, u2c
                if src is client:
                    c2u += len(data)
                else:
                    u2c += len(data)
                dst.sendall(data)
    except OSError as e:
        reason = f"oserror:{getattr(e, 'errno', e)}"
    finally:
        for s in (client, upstream):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                s.close()
            except OSError:
                pass
    return reason, c2u, u2c


def _tune(s: socket.socket) -> None:
    s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    try:
        # v2.10.0_3: Google/IDE dropped idle tunnels at ~10s; probe sooner
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, 8)
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, 3)
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, 3)
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_QUICKACK, 1)
    except (OSError, AttributeError):
        pass


def _tcp_alive(ip: str, port: int = 443, timeout: float = 0.7) -> bool:
    try:
        s = socket.create_connection((ip, port), timeout=timeout)
        s.close()
        return True
    except OSError:
        return False


def _dial_fast(ips: list[str], port: int, timeout: float) -> tuple[socket.socket, str]:
    """Staggered happy eyeballs: first TCP that completes wins; extras are closed."""
    if not ips:
        raise OSError("no targets")
    if len(ips) == 1:
        s = socket.create_connection((ips[0], port), timeout=timeout)
        _tune(s)
        return s, ips[0]
    lock = threading.Lock()
    winner: list[tuple[socket.socket, str]] = []
    errors: list[BaseException] = []
    done = threading.Event()

    def one(ip: str) -> None:
        if done.is_set():
            return
        try:
            s = socket.create_connection((ip, port), timeout=timeout)
            _tune(s)
        except OSError as e:
            errors.append(e)
            return
        with lock:
            if not winner:
                winner.append((s, ip))
                done.set()
                return
        try:
            s.close()
        except OSError:
            pass

    threads: list[threading.Thread] = []
    for ip in ips:
        t = threading.Thread(target=one, args=(ip,), daemon=True)
        threads.append(t)
        t.start()
        if done.wait(0.05):
            break
    if not done.wait(timeout + 0.2):
        pass
    if winner:
        return winner[0]
    raise errors[-1] if errors else OSError("connect timed out")


def _dial(host: str, port: int) -> tuple[socket.socket, str | None]:
    if host in CLOUDCODE_HOSTS:
        targets = _usable(_uniq(_with_sticky(host, resolve_cloudcode(host) + list(FALLBACK))))
        try:
            sock, ip = _dial_fast(targets, port, CONNECT_TIMEOUT)
            return sock, ip
        except OSError:
            targets = _usable(
                _uniq(_with_sticky(host, resolve_cloudcode(host, force=True) + list(FALLBACK)))
            )
            sock, ip = _dial_fast(targets, port, CONNECT_TIMEOUT)
            return sock, ip
    s = socket.create_connection((host, port), timeout=4)
    _tune(s)
    return s, None


def _handle(client: socket.socket) -> None:
    client.settimeout(15)
    try:
        buf = b""
        while b"\r\n\r\n" not in buf and len(buf) < 8192:
            chunk = client.recv(1024)
            if not chunk:
                client.close()
                return
            buf += chunk
        line = buf.split(b"\r\n", 1)[0].decode("ascii", "replace")
        parts = line.split()
        if len(parts) < 2 or parts[0].upper() != "CONNECT":
            client.sendall(b"HTTP/1.1 405 Method Not Allowed\r\nConnection: close\r\n\r\n")
            client.close()
            return
        hostport = parts[1]
        if ":" in hostport:
            host, port_s = hostport.rsplit(":", 1)
            port = int(port_s)
        else:
            host, port = hostport, 443
        leftover = buf.split(b"\r\n\r\n", 1)[1] if b"\r\n\r\n" in buf else b""
        try:
            upstream, up_ip = _dial(host, port)
        except OSError:
            client.sendall(b"HTTP/1.1 502 Bad Gateway\r\nConnection: close\r\n\r\n")
            client.close()
            return
        client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
        if leftover:
            upstream.sendall(leftover)
        client.settimeout(None)
        upstream.settimeout(None)
        try:
            _tune(client)
        except OSError:
            pass
        reason, c2u, u2c = _pipe(client, upstream)
        if up_ip and u2c >= 512:
            _sticky[host] = up_ip
        if (
            up_ip
            and c2u > 32
            and u2c < 512
            and (reason.startswith("upstream") or reason.startswith("oserror") or reason == "error")
        ):
            _ban(up_ip, f"{reason} c2u={c2u} u2c={u2c}")
        elif reason not in ("client-eof", "upstream-eof"):
            log.info("tunnel %s %s c2u=%s u2c=%s", host, reason, c2u, u2c)
    except OSError:
        try:
            client.close()
        except OSError:
            pass


def _warm() -> None:
    name = "daily-cloudcode-pa.googleapis.com"
    while True:
        try:
            ip = _sticky.get(name)
            if ip and _is_banned(ip):
                _sticky.pop(name, None)
                ip = None
            if ip and _tcp_alive(ip):
                with _cache_lock:
                    hit = _cache.get(name)
                    if hit:
                        _cache[name] = (hit[0], hit[1], time.monotonic())
            else:
                if ip:
                    _sticky.pop(name, None)
                resolve_cloudcode(name, force=True)
        except Exception as e:
            log.warning("warm: %s", e)
        time.sleep(WARM_EVERY)


def main() -> None:
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(LISTEN)
    srv.listen(64)
    _log_line(f"listen {LISTEN[0]}:{LISTEN[1]}")
    threading.Thread(target=_warm, daemon=True).start()
    while True:
        client, _ = srv.accept()
        threading.Thread(target=_handle, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()
